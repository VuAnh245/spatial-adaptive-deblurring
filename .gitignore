# anchored to the repo root: an unanchored "data/" also ignores src/spatial_deblur/data/
/data/
/checkpoints/
/results/
.pytest_cache/
.venv/
third_party/*
!third_party/README.md
__pycache__/
*.egg-info/
.ipynb_checkpoints/
*.pth
*.pt
# large or partial artifacts that can appear outside results/ and data/
*.npz
*.zip
*.part
# credentials (also covered by the user's global ignore for .claude/settings.local.json)
.env
kaggle.json
access_token
.claude/settings.local.json
